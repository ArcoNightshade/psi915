i915: implement remap_io_mapping/remap_io_sg with lkpi_vma_insert_pfns()

The upstream implementations write PTEs with apply_to_page_range().  On illumos user mappings are
devmap(9E) mappings managed by drmglue, which loads translations through
lkpi_vma_insert_pfns() (docs/10, R7).  The GTT and LMEM/sg mmap paths of i915_gem_mman.c call
these two functions unchanged.  The prototype is declared locally so that i915 does not depend on
drmglue's internal header layout; drmglue/include/drmglue/lkpi_mm.h has the same declaration.

Upstream: not-applicable (illumos only; guarded by CONFIG_PSI915)

diff --git a/i915/drivers/gpu/drm/i915/i915_mm.c b/i915/drivers/gpu/drm/i915/i915_mm.c
index 76e2801..4c48973 100644
--- a/i915/drivers/gpu/drm/i915/i915_mm.c
+++ b/i915/drivers/gpu/drm/i915/i915_mm.c
@@ -48,6 +48,80 @@ static inline unsigned long sgt_pfn(const struct remap_pfn *r)
 		return r->sgt.pfn + (r->sgt.curr >> PAGE_SHIFT);
 }
 
+#ifdef CONFIG_PSI915
+/*
+ * psi915 (docs/10, R7): illumos has no page tables to fill with apply_to_page_range().  The
+ * drmglue VMA layer loads translations through lkpi_vma_insert_pfns() into the devmap mapping
+ * behind the VMA, so remap_io_mapping() and remap_io_sg() become loops over it.
+ */
+int lkpi_vma_insert_pfns(struct vm_area_struct *vma, unsigned long addr,
+			 const unsigned long *pfns, unsigned long pfn_base,
+			 unsigned long n, pgprot_t prot);
+
+#define PSI915_EXPECTED_FLAGS (VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP)
+#define PSI915_REMAP_BATCH 64
+
+int remap_io_mapping(struct vm_area_struct *vma,
+		     unsigned long addr, unsigned long pfn, unsigned long size,
+		     struct io_mapping *iomap)
+{
+	GEM_BUG_ON((vma->vm_flags & PSI915_EXPECTED_FLAGS) != PSI915_EXPECTED_FLAGS);
+
+	/* The io_mapping's cache mode (write-combining) applies, as upstream. */
+	return lkpi_vma_insert_pfns(vma, addr, NULL, pfn, size >> PAGE_SHIFT,
+				    iomap->prot);
+}
+
+int remap_io_sg(struct vm_area_struct *vma,
+		unsigned long addr, unsigned long size,
+		struct scatterlist *sgl, unsigned long offset,
+		resource_size_t iobase)
+{
+	struct remap_pfn r = {
+		.prot = vma->vm_page_prot,
+		.sgt = __sgt_iter(sgl, use_dma(iobase)),
+		.iobase = iobase,
+	};
+	unsigned long pfns[PSI915_REMAP_BATCH];
+	unsigned long n = size >> PAGE_SHIFT, done = 0;
+	int err = 0;
+
+	GEM_BUG_ON((vma->vm_flags & PSI915_EXPECTED_FLAGS) != PSI915_EXPECTED_FLAGS);
+
+	while (offset >= r.sgt.max >> PAGE_SHIFT) {
+		offset -= r.sgt.max >> PAGE_SHIFT;
+		r.sgt = __sgt_iter(__sg_next(r.sgt.sgp), use_dma(iobase));
+		if (!r.sgt.sgp)
+			return -EINVAL;
+	}
+	r.sgt.curr = offset << PAGE_SHIFT;
+
+	while (done < n) {
+		unsigned long k = 0;
+
+		while (k < PSI915_REMAP_BATCH && done + k < n) {
+			if (GEM_WARN_ON(!r.sgt.sgp)) {
+				err = -EINVAL;
+				break;
+			}
+			pfns[k++] = sgt_pfn(&r);
+			r.sgt.curr += PAGE_SIZE;
+			if (r.sgt.curr >= r.sgt.max)
+				r.sgt = __sgt_iter(__sg_next(r.sgt.sgp),
+						   use_dma(iobase));
+		}
+		if (k > 0 && !err)
+			err = lkpi_vma_insert_pfns(vma, addr + (done << PAGE_SHIFT),
+						   pfns, 0, k, r.prot);
+		if (err)
+			break;
+		done += k;
+	}
+	if (unlikely(err) && done)
+		zap_vma_ptes(vma, addr, done << PAGE_SHIFT);
+	return err;
+}
+#else /* !CONFIG_PSI915: upstream page-table implementation */
 static int remap_sg(pte_t *pte, unsigned long addr, void *data)
 {
 	struct remap_pfn *r = data;
@@ -162,3 +236,4 @@ int remap_io_sg(struct vm_area_struct *vma,
 
 	return 0;
 }
+#endif /* CONFIG_PSI915 */
