# psi915 Kconfig-equivalent choices for the Gen9 (Kaby Lake-R, 8086:5917) target on illumos amd64.
# Format: Linux .config ("CONFIG_X=y", "CONFIG_X=123", "CONFIG_X=\"str\"", "# CONFIG_X is not set").
# scripts/import-linux.sh turns this into drm/include/generated/autoconf.h.  Any CONFIG_* symbol not listed
# is "not set", as in Linux.  "is not set" lines are listed explicitly where the choice matters; the text after
# "--" on the line above each block is the reason.  Choices marked (unverified) have not been checked against
# a compiling tree; a real build may force changes.  tools/kpi-config-usage.tsv lists every CONFIG_* symbol the
# imported tree tests and how this file resolves it.

# -- Architecture: illumos amd64, SMP, PCI, ACPI.
CONFIG_X86=y
CONFIG_X86_64=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_ACPI_SLEEP=y
CONFIG_DMI=y
CONFIG_X86_PAT=y
CONFIG_AS_MOVNTDQA=y
CONFIG_NEED_SG_DMA_LENGTH=y
CONFIG_ARCH_HAVE_NMI_SAFE_CMPXCHG=y
CONFIG_MMU=y
CONFIG_MODULES=y
# -- No MTRR interface on illumos; write-combining comes from PAT (arch_phys_wc_add() becomes a no-op).
# CONFIG_MTRR is not set
# -- 32-bit AGP/intel-gtt (Gen2-5 GGTT) is irrelevant on amd64 Gen9.
# CONFIG_AGP is not set
# CONFIG_AGP_INTEL is not set
# CONFIG_INTEL_GTT is not set
# -- No swiotlb on illumos; DMA goes through ddi_dma (rootnex/immu).
# CONFIG_SWIOTLB is not set
# -- illumos IOMMU (immu) is not the Linux intel-iommu driver; i915 VT-d quirks key off this (unverified effect).
# CONFIG_INTEL_IOMMU is not set
# CONFIG_IOMMU_API is not set
# -- Kernel preemption model: illumos kernel threads are preemptible, but Linux preempt_count semantics are
#    not emulated; keep the non-preemptible variants of the macros.
# CONFIG_PREEMPTION is not set
# CONFIG_PREEMPT_RT is not set
# CONFIG_PREEMPT_COUNT is not set

# -- Power management: suspend/resume and runtime PM code paths stay compiled; the KPI maps them to
#    DDI_SUSPEND/DDI_RESUME and may stub runtime PM.  Hibernation is out of scope.
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
# CONFIG_HIBERNATION is not set

# -- Linux-only infrastructure with no illumos equivalent planned for the first bring-up.
# CONFIG_DEBUG_FS is not set
# CONFIG_PROC_FS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_HWMON is not set
# CONFIG_TRACEPOINTS is not set
# CONFIG_FTRACE is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_KASAN is not set
# CONFIG_KCOV is not set
# CONFIG_FAULT_INJECTION is not set
# CONFIG_STACKDEPOT is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_CGROUP_DMEM is not set
# -- 32-bit ioctl translation (CONFIG_COMPAT) deferred: illumos does this per ioctl with ddi_model_convert_from.
# CONFIG_COMPAT is not set
# -- userptr needs mmu_notifier; deferred (I915_GEM_USERPTR returns -ENODEV).  iris works without it.
# CONFIG_MMU_NOTIFIER is not set
# -- Firmware/peripheral frameworks not needed for KBL-R eDP + DP/HDMI:
# CONFIG_ACPI_VIDEO is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_VGA_ARB is not set
# CONFIG_VGA_SWITCHEROO is not set
# CONFIG_IOSF_MBI is not set
# CONFIG_INTEL_MEI_HDCP is not set
# CONFIG_INTEL_MEI_PXP is not set
# CONFIG_INTEL_MEI_GSC is not set
# CONFIG_SND_HDA_COMPONENT is not set
# CONFIG_SND_HDA_I915 is not set
# CONFIG_FB is not set
# CONFIG_FB_CORE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_OF is not set
CONFIG_VIDEO=y
CONFIG_VIDEO_CMDLINE=y
CONFIG_HDMI=y
# -- dma-buf core and sync_file fds (drivers/dma-buf; GPL module, docs/08 section 5).
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
# CONFIG_DMABUF_HEAPS is not set
# CONFIG_SW_SYNC is not set
# CONFIG_UDMABUF is not set
# CONFIG_DMABUF_SYSFS_STATS is not set
# CONFIG_DMABUF_MOVE_NOTIFY is not set
# CONFIG_DMABUF_DEBUG is not set
# CONFIG_DMABUF_SELFTESTS is not set
CONFIG_APERTURE_HELPERS=y

# -- DRM core and helpers used by i915.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_DISPLAY_HDCP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_DRM_PRIVACY_SCREEN=y
CONFIG_DRM_TTM=y
CONFIG_DRM_BUDDY=y
# -- In-kernel clients/fbdev: the illumos console (tem/vgatext) is not fbcon; console handoff is psi915 glue.
# CONFIG_DRM_CLIENT is not set
# CONFIG_DRM_CLIENT_SETUP is not set
# CONFIG_DRM_CLIENT_LIB is not set
# CONFIG_DRM_CLIENT_SELECTION is not set
# CONFIG_DRM_CLIENT_LOG is not set
# CONFIG_DRM_LOAD_EDID_FIRMWARE is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DRM_PANIC is not set
# -- Helpers imported as "extra" but not built for Gen9.
# CONFIG_DRM_SCHED is not set
# CONFIG_DRM_EXEC is not set
# CONFIG_DRM_GPUVM is not set
# CONFIG_DRM_SUBALLOC_HELPER is not set
# -- Legacy/debug/optional DRM features.
# CONFIG_DRM_LEGACY is not set
# CONFIG_DRM_DEBUG_MM is not set
# CONFIG_DRM_DEBUG_SELFTEST is not set
# CONFIG_DRM_DEBUG_MODESET_LOCK is not set
# CONFIG_DRM_DEBUG_DP_MST_TOPOLOGY_REFS is not set
# CONFIG_DRM_USE_DYNAMIC_DEBUG is not set
# CONFIG_DRM_DP_AUX_CHARDEV is not set
# CONFIG_DRM_DP_CEC is not set
# CONFIG_DRM_DISPLAY_DP_AUX_CEC is not set
# CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV is not set
# CONFIG_DRM_DISPLAY_DP_TUNNEL is not set
# CONFIG_DRM_DISPLAY_DP_TUNNEL_STATE_DEBUG is not set
# CONFIG_DRM_ACCEL is not set
# CONFIG_DRM_PANEL_BRIDGE is not set
# CONFIG_DRM_KUNIT_TEST is not set
# CONFIG_DRM_TTM_KUNIT_TEST is not set
# CONFIG_DRM_EXPORT_FOR_TESTS is not set
# CONFIG_DRM_WERROR is not set

# -- i915.
CONFIG_DRM_I915=y
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_DRM_I915_USERFAULT_AUTOSUSPEND=250
CONFIG_DRM_I915_REQUEST_TIMEOUT=20000
CONFIG_DRM_I915_FENCE_TIMEOUT=10000
CONFIG_DRM_I915_HEARTBEAT_INTERVAL=2500
CONFIG_DRM_I915_PREEMPT_TIMEOUT=640
CONFIG_DRM_I915_PREEMPT_TIMEOUT_COMPUTE=7500
CONFIG_DRM_I915_MAX_REQUEST_BUSYWAIT=8000
CONFIG_DRM_I915_STOP_TIMEOUT=100
CONFIG_DRM_I915_TIMESLICE_DURATION=1
# -- GVT-g (host) and KVMGT: no hypervisor integration on illumos.
# CONFIG_DRM_I915_GVT is not set
# CONFIG_DRM_I915_GVT_KVMGT is not set
# -- Gen12+-only features.
# CONFIG_DRM_I915_PXP is not set
# CONFIG_DRM_I915_DP_TUNNEL is not set
# -- Error capture deferred (needs sysfs bin attributes and optionally zlib); hang reset does not need it.
# CONFIG_DRM_I915_CAPTURE_ERROR is not set
# CONFIG_DRM_I915_COMPRESS_ERROR is not set
# CONFIG_DRM_I915_REPLAY_GPU_HANGS_API is not set
# -- Selftests and debug options.
# CONFIG_DRM_I915_SELFTEST is not set
# CONFIG_DRM_I915_SELFTEST_BROKEN is not set
# CONFIG_DRM_I915_DEBUG is not set
# CONFIG_DRM_I915_DEBUG_MMIO is not set
# CONFIG_DRM_I915_DEBUG_GEM is not set
# CONFIG_DRM_I915_DEBUG_GEM_ONCE is not set
# CONFIG_DRM_I915_DEBUG_GUC is not set
# CONFIG_DRM_I915_DEBUG_RUNTIME_PM is not set
# CONFIG_DRM_I915_DEBUG_WAKEREF is not set
# CONFIG_DRM_I915_SW_FENCE_DEBUG_OBJECTS is not set
# CONFIG_DRM_I915_SW_FENCE_CHECK_DAG is not set
# CONFIG_DRM_I915_LOW_LEVEL_TRACEPOINTS is not set
# CONFIG_DRM_I915_TRACE_GEM is not set
# CONFIG_DRM_I915_TRACE_GTT is not set
# CONFIG_DRM_I915_WERROR is not set
# CONFIG_DRM_I915_DEBUG_VBLANK_EVADE is not set
