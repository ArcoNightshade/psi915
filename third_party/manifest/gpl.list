selftest	drivers/gpu/drm/i915/selftests/i915_live_selftests.h	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
selftest	drivers/gpu/drm/i915/selftests/i915_mock_selftests.h	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
selftest	drivers/gpu/drm/i915/selftests/i915_perf_selftests.h	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
selftest	drivers/gpu/drm/i915/selftests/lib_sw_fence.h	CONFIG_DRM_I915_SELFTEST off [GPL-2.0-only]
selftest	drivers/gpu/drm/i915/selftests/mock_gem_device.h	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
core	drivers/video/cmdline.c	video= options and nomodeset (CONFIG_VIDEO), used by DRM core [GPL-2.0]
core	drivers/video/nomodeset.c	video= options and nomodeset (CONFIG_VIDEO), used by DRM core [GPL-2.0]
