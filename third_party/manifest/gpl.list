# psi915 import manifest: gpl.list
# Format: <set><TAB><upstream path><TAB><reason>.  A path ending in "/" covers everything below it; the longest
# matching entry wins.  "scope" lines name the upstream directories that must be fully classified.
# Destination: gpl/<upstream path>.
# Sets imported by default: core link hdr uapi extra aux.
#   core   compiled for the Gen9 (KBL-R) target
#   link   compiled only for link closure: code for non-Gen9 hardware (candidate for stub patches)
#   hdr    header;  uapi  userspace ABI header
#   extra  imported (requested subsystem or helper) but not compiled for the Gen9 target
#   aux    non-compiled supporting source
# Optional sets (import-linux.sh -s <set>): debugfs fbdev compat capture perf selftest gen12 hwmon gvt kunit
#   edidfw auxdev cec
#   exclude never imported
# gpl.list: GPL-only files (no MIT/BSD alternative in their SPDX tag).  They form the separate GPL-2.0 module
# (docs/08 section 5); import-linux.sh refuses GPL-only files in drm/ or i915/.
hdr	drivers/dma-buf/dma-buf-sysfs-stats.h	dma-buf internal header [GPL-2.0-only]
core	drivers/dma-buf/dma-buf.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
core	drivers/dma-buf/dma-fence-array.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
core	drivers/dma-buf/dma-fence-chain.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
core	drivers/dma-buf/dma-fence-unwrap.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
core	drivers/dma-buf/dma-fence.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
hdr	drivers/dma-buf/sync_debug.h	dma-buf internal header [GPL(text)]
core	drivers/dma-buf/sync_file.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915) [GPL-2.0-only]
hdr	drivers/dma-buf/sync_trace.h	dma-buf internal header [GPL-2.0]
extra	drivers/gpu/drm/display/drm_bridge_connector.c	display helper with no i915 user [GPL-2.0+]
cec	drivers/gpu/drm/display/drm_dp_cec.c	DP CEC tunnelling; CONFIG_DRM_DISPLAY_DP_AUX_CEC off [GPL-2.0]
hdr	drivers/gpu/drm/display/drm_dp_mst_topology_internal.h	display helper internal header [GPL-2.0-only]
core	drivers/gpu/drm/display/drm_hdcp_helper.c	DRM display helpers used by i915 (DP, MST, DSC, HDCP, HDMI, SCDC) [GPL-2.0]
edidfw	drivers/gpu/drm/drm_edid_load.c	CONFIG_DRM_LOAD_EDID_FIRMWARE off [GPL-2.0-or-later]
extra	drivers/gpu/drm/drm_gem_atomic_helper.c	drm_kms_helper member; no i915 user [GPL-2.0-or-later]
core	drivers/gpu/drm/drm_gem_framebuffer_helper.c	DRM core / KMS helper [GPL-2.0-or-later]
extra	drivers/gpu/drm/drm_gem_ttm_helper.c	TTM GEM helper; no i915 user [GPL-2.0-or-later]
core	drivers/gpu/drm/drm_lease.c	lease ioctls are in the core ioctl table [GPL-2.0-or-later]
core	drivers/gpu/drm/drm_managed.c	DRM core / KMS helper [GPL-2.0]
extra	drivers/gpu/drm/drm_panel_backlight_quirks.c	amdgpu quirk table [GPL-2.0]
extra	drivers/gpu/drm/drm_simple_kms_helper.c	drm_kms_helper member; no i915 user [GPL-2.0-or-later]
core	drivers/gpu/drm/drm_sysfs.c	DRM core / KMS helper [GPL-2.0-only]
hdr	drivers/gpu/drm/drm_trace.h	DRM internal header [GPL-2.0]
core	drivers/gpu/drm/drm_trace_points.c	tracepoint definitions (empty with CONFIG_TRACEPOINTS off); in drm.ko upstream [no notice: GPL-2.0 by kernel default (COPYING)]
core	drivers/gpu/drm/drm_writeback.c	no i915 user, but drm_atomic*.c call writeback functions (link closure); part of drm.ko upstream [GPL-2.0]
core	drivers/gpu/drm/i915/display/intel_acpi.c	i915 (unconditional or CONFIG_X86/CONFIG_ACPI in the upstream Makefile) [GPL-2.0]
core	drivers/gpu/drm/i915/display/intel_display_trace.c	i915 (unconditional or CONFIG_X86/CONFIG_ACPI in the upstream Makefile) [GPL-2.0]
hdr	drivers/gpu/drm/i915/display/intel_display_trace.h	i915 header [GPL-2.0]
selftest	drivers/gpu/drm/i915/gt/selftest_context.c	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
selftest	drivers/gpu/drm/i915/gt/selftest_engine.c	CONFIG_DRM_I915_SELFTEST off [GPL-2.0]
