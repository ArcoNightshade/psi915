# psi915 import manifest: drm.list
# Format: <set><TAB><upstream path in drm-kmod><TAB><reason>.  A path ending in "/" covers everything below it;
# the longest matching entry wins.  Destination: drm/<upstream path>.
# Sets imported by default: core link hdr uapi extra aux kpi-ref.
#   core    compiled for the Gen9 (KBL-R) target
#   link    compiled only for link closure: code paths for non-Gen9 hardware (candidates for stub patches)
#   hdr     header (imported whole; use is decided by the compiler, not per file here)
#   uapi    userspace ABI header
#   extra   imported (requested subsystem or helper) but not compiled for the Gen9 target
#   aux     non-compiled supporting source
#   kpi-ref drm-kmod-carried LinuxKPI headers, reference only
# Optional sets (import-linux.sh -s <set>): debugfs fbdev compat capture perf selftest gen12 hwmon lpe auxdev
#   exclude never imported
exclude	.github/	CI config
exclude	.gitignore	VCS
exclude	Makefile	FreeBSD build
exclude	README.md	drm-kmod README
exclude	amd/	amdgpu module Makefiles
exclude	compiler_flags.mk	FreeBSD build (reference: warning flags)
exclude	dmabuf/	FreeBSD module Makefile
exclude	drivers/dma-buf/dma-buf-kmod.c	FreeBSD module glue
core	drivers/dma-buf/dma-buf.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/dma-fence-array.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/dma-fence-chain.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/dma-fence-unwrap.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/dma-fence.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/dma-resv.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
core	drivers/dma-buf/sync_file.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
exclude	drivers/gpu/drm/amd/	amdgpu (out of scope)
