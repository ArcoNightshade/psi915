# psi915 import manifest: drm.list
# Format: <set><TAB><upstream path><TAB><reason>.  A path ending in "/" covers everything below it; the longest
# matching entry wins.  "scope" lines name the upstream directories that must be fully classified.
# Destination: drm/<upstream path>.
# Sets imported by default: core link hdr uapi extra aux inc.
#   core   compiled for the Gen9 (KBL-R) target
#   link   compiled only for link closure: code for non-Gen9 hardware (candidate for stub patches)
#   hdr    header;  uapi  userspace ABI header
#   extra  imported (requested subsystem or helper) but not compiled for the Gen9 target
#   aux    non-compiled supporting source
#   inc    C source #included by another file (imported, never compiled on its own)
# Optional sets (import-linux.sh -s <set>): debugfs fbdev compat capture perf selftest gen12 hwmon gvt kunit
#   edidfw auxdev cec replaced
#   exclude never imported
scope	drivers/gpu/drm/	must be fully classified
scope	drivers/dma-buf/	must be fully classified
scope	drivers/video/	must be fully classified
scope	include/drm/	must be fully classified
scope	include/uapi/drm/	must be fully classified
exclude	drivers/dma-buf/Kconfig	build file
exclude	drivers/dma-buf/Makefile	build file
exclude	drivers/dma-buf/dma-buf-sysfs-stats.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/dma-heap.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
core	drivers/dma-buf/dma-resv.c	dma-buf/dma-fence/dma-resv/sync_file (used by DRM core and i915)
exclude	drivers/dma-buf/heaps/Kconfig	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/heaps/Makefile	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/heaps/cma_heap.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/heaps/system_heap.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
selftest	drivers/dma-buf/selftest.c	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/selftest.h	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/selftests.h	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/st-dma-fence-chain.c	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/st-dma-fence-unwrap.c	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/st-dma-fence.c	CONFIG_DMABUF_SELFTESTS off
selftest	drivers/dma-buf/st-dma-resv.c	CONFIG_DMABUF_SELFTESTS off
exclude	drivers/dma-buf/sw_sync.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/sync_debug.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/dma-buf/udmabuf.c	dma-buf heaps/udmabuf/sw_sync/sysfs stats: not needed by i915
exclude	drivers/gpu/drm/Kconfig	build/Kconfig/Rust or other non-C file
exclude	drivers/gpu/drm/Makefile	build/Kconfig/Rust or other non-C file
