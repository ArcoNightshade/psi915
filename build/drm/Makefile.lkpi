#
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The psi915 Authors. All rights reserved.
#
# Common rules for the kernel modules built from imported Linux sources:
# linuxkpi_drm (build/drm), linuxkpi_gpl_g1, linuxkpi_gpl_g2 and i915.
# Included by build/<module>/Makefile after it sets:
#
#   BUILDBASE      path of build/ (..)
#   MODULE         kmod file name (linuxkpi_drm, i915, ...)
#   MODDEPS        dependencies, e.g. misc/linuxkpi misc/linuxkpi_drm. Passed
#                  to ld as -N, i.e. DT_NEEDED entries, which krtld reads
#                  (the gate's mechanism; the old _depends_on array is
#                  deprecated and not used)
#   LINUX_MODNAME  KBUILD_MODNAME for the Linux sources (pr_fmt, messages)
#   LKPI_LICENCE   mit (drm/, i915/, drm_bsd/), gpl (G2) or kpi (G1, which
#                  may include KPI headers only, gpl-policy check 4): decides
#                  the include path. gpl/include is on it only for gpl; MIT/
#                  BSD code sees only the allow-header debts of
#                  third_party/gpl-policy.conf; kpi sees neither
#   LINUX_SRCS     imported sources, repository-relative (from Objects.mk)
#   GLUE_SRCS      psi915 BSD sources (module linkage, drmglue, driver glue),
#                  repository-relative; compiled with -Werror
#   MODULE_INC     extra -I flags placed before the KPI headers
#   MODULE_INC_LATE  extra -I flags after drm/include and i915/include (the
#                  kbuild -I$(src) of a driver root, for drm_bsd sources that
#                  live outside the directory of the headers they include)
#   MODULE_DEFS    extra -D flags for every source of the module
#
# Per-file flags: CFLAGS_<basename> (e.g. CFLAGS_intel_display = -O1), as
# kbuild's CFLAGS_<obj>.o.
#
# Targets:
#   all            build $(OBJS_DIR)/$(MODULE) (obj64, or debug64 with DEBUG=1)
#   syntax-check   gcc -fsyntax-only on every translation unit, never stops on
#                  errors; writes $(OBJS_DIR)/syntax-report.tsv and prints the
#                  failing units (gmake -j8 syntax-check). HOST_STUBS=1 runs it
#                  on a non-illumos host against tests/stubs/illumos.
#   objlist        print the sources and counts
#   sizecheck      print section sizes of the linked module, warn above
#                  MODSIZE_WARN_KB
#   install        scripts/install-all.sh for this module only
#   clean/clobber
# `gmake -n` shows every command without running it.
#
# UNTESTED ON ILLUMOS: written in a Linux container; only the syntax-check
# target with HOST_STUBS=1 and `gmake -n` have been run (docs/11).
#

include $(BUILDBASE)/Makefile.master

DRMBUILD	= $(BUILDBASE)/drm
SIZE		= size
MODSIZE_WARN_KB	= 32768

#
# Where drmglue (the DRM character device and Linux file layer) is linked.
#   g1     (default) linuxkpi_gpl_g1: the dma-buf group needs drmglue's file
#          layer (fd_install, anon_inode_getfile, alloc_file_pseudo, ...;
#          docs/10 R9) and may depend on linuxkpi only, and drmglue cannot be
#          split (anonfile.c uses cdev_illumos.c's host major). linuxkpi_drm
#          already depends on G1, so it sees drmglue too.
#   drm    linuxkpi_drm: G1 would then need misc/linuxkpi_drm, a dependency
#          cycle (drm needs dma_fence_*). Not loadable; kept for the case
#          that G1 is replaced by BSD code again.
#   none   linked elsewhere (target layout: inside linuxkpi, requested in
#          docs/11 section 7).
#
DRMGLUE_IN	= g1

#
# Configuration headers. linux/kconfig.h includes generated/autoconf.h
# (drm/include/generated/autoconf.h, generated by scripts/import-linux.sh
# from third_party/config/gen9.config), as kbuild's -include does.
#
AUTOCONF_H	= $(SRCBASE)/drm/include/generated/autoconf.h
KCONFIG_H	= $(INCBASE)/linux/kconfig.h

#
# Include path, in order:
#   module specific, drm_bsd (BSD replacements shadow GPL headers),
#   drmglue, KPI include/, drm/include (+uapi), i915/include,
#   gpl/include (gpl modules only) or the allow-header debt links (MIT),
#   kernel headers (KERNEL_INC or the compiler default /usr/include).
#
GPLALLOW	= $(OBJS_DIR)/gplallow
LINUX_INC_mit	= -I$(GPLALLOW)/include -I$(GPLALLOW)/local
LINUX_INC_gpl	= -I$(SRCBASE)/gpl/include
INCLUDE_PATH	= $(MODULE_INC) \
		  -I$(SRCBASE)/drm_bsd/include \
		  -I$(SRCBASE)/drm_bsd/drivers/gpu/drm \
		  -I$(SRCBASE)/drmglue/include \
		  -I$(INCBASE) \
		  -I$(SRCBASE)/drm/include \
		  -I$(SRCBASE)/drm/include/uapi \
		  -I$(SRCBASE)/i915/include \
		  $(MODULE_INC_LATE) \
		  $(LINUX_INC_$(LKPI_LICENCE)) \
		  $(HOST_STUB_INC) \
		  $(if $(KERNEL_INC),-I$(KERNEL_INC))

LINUX_DEFS	= -D__KERNEL__ -DKBUILD_MODNAME='"$(LINUX_MODNAME)"' \
		  -include $(KCONFIG_H) $(MODULE_DEFS)
CPPFLAGS	= $(ALWAYS_DEFS) $(DEBUG_DEFS) $(INCLUDE_PATH) $(LINUX_DEFS) \
		  $(EXTRA_CPPFLAGS)

#
# kbuild code-generation flags that change semantics (Linux code relies on
# them): no strict aliasing, defined signed overflow, null checks kept,
# no common symbols. Plus the illumos kernel flags of Makefile.master.
#
LINUX_CODEGEN	= -fno-strict-aliasing -fno-strict-overflow \
		  -fno-delete-null-pointer-checks -fno-common \
		  -fno-stack-check -fconserve-stack
#
# Warnings: imported code is not ours to fix, so no -Werror and no -Wextra
# (LINUX_WERROR=1 restores -Werror). Glue sources keep the project policy.
#
LINUX_WERROR	= 0
LINUX_CERRWARN	= -Wall -Wno-unused-parameter -Wno-sign-compare \
		  -Wno-missing-field-initializers -Wno-pointer-sign \
		  -Wno-unused-but-set-variable -Wno-unused-const-variable \
		  -Wno-format-truncation -Wno-stringop-truncation \
		  -Wno-address-of-packed-member -Wno-frame-address \
		  $(if $(filter 1,$(LINUX_WERROR)),-Werror)
GLUE_CERRWARN	= -Wall -Wextra -Werror -Wno-unused-parameter \
		  -Wno-missing-field-initializers -Wno-sign-compare
CERRWARN	= $(LINUX_CERRWARN)
EXTRA_CFLAGS	+= $(LINUX_CODEGEN)

#
# HOST_STUBS=1: compile on a non-illumos host (the Linux dev container)
# against the stub illumos headers. Only meaningful for syntax-check; the
# objects are not a kernel build.
#
HOST_STUBS	= 0
ifeq ($(HOST_STUBS),1)
ILLUMOS_GCC_FLAGS =
HOST_STUB_INC	= -nostdinc $(HOST_STUB_PRE) -I$(SRCBASE)/tests/stubs/illumos \
		  -I$(SRCBASE)/drmglue/stubs/illumos
# Glue sources use more illumos headers: drivers/i915_glue's and drmglue's
# stubs (which define cred_t, vnodes, ...) take precedence for them.
GLUE_HOST_STUB_PRE = -I$(SRCBASE)/drivers/i915_glue/stubs/illumos \
		  -I$(SRCBASE)/drmglue/stubs/illumos
endif

#
# CTF. Imported code may produce DWARF ctfconvert does not handle; by
# default a failure is a warning and the module is linked without CTF
# (CTF_STRICT=1 makes it fatal).
#
CTF_STRICT	= 0
CTF_FAIL	= $(if $(filter 1,$(CTF_STRICT)),exit 1,echo "warning: CTF step failed for $@ (CTF_STRICT=0)")

#
# Objects mirror the repository layout below $(OBJS_DIR)/objs, so files with
# the same basename in different directories cannot collide (and the i915/
# source tree cannot collide with the module file $(OBJS_DIR)/i915).
#
OBJTREE		= $(OBJS_DIR)/objs
LINUX_OBJS	= $(LINUX_SRCS:%.c=$(OBJTREE)/%.o)
GLUE_OBJS	= $(GLUE_SRCS:%.c=$(OBJTREE)/%.o)
OBJECTS		= $(LINUX_OBJS) $(GLUE_OBJS)
BINARY		= $(OBJS_DIR)/$(MODULE)
ALL_SRCS	= $(LINUX_SRCS) $(GLUE_SRCS)

$(GLUE_OBJS) $(GLUE_SRCS:%.c=$(OBJS_DIR)/syntax/%.syn): CERRWARN = $(GLUE_CERRWARN)
$(GLUE_OBJS) $(GLUE_SRCS:%.c=$(OBJS_DIR)/syntax/%.syn): HOST_STUB_PRE = $(GLUE_HOST_STUB_PRE)

.PHONY: all install clean clobber syntax-check objlist sizecheck gplallow FORCE

all: $(BINARY)

$(BINARY): $(OBJECTS)
	$(LD) $(LD_KMOD_TYPE) $(LDFLAGS) -o $@ $(OBJECTS)
	$(if $(CTFMERGE),$(CTFMERGE) $(CTFMRGFLAGS) -o $@ $(OBJECTS) || { $(CTF_FAIL); })
	@echo "$(MODULE): linked $(words $(OBJECTS)) objects -> $@"

$(OBJTREE)/%.o: $(SRCBASE)/%.c | gplallow
	@mkdir -p $(@D)
	$(COMPILE.c) -DKBUILD_BASENAME='"$(*F)"' $(CFLAGS_$(*F)) -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@ || { $(CTF_FAIL); })

#
# Allow-header debts (third_party/gpl-policy.conf "allow-header"): GPL
# headers MIT/BSD code still includes. Only these are linked into an include
# directory, so gpl/include itself is never on an MIT/BSD include path.
#
GPLPOLICY	= $(SRCBASE)/third_party/gpl-policy.conf
gplallow: $(GPLALLOW)/.stamp

$(GPLALLOW)/.stamp: $(GPLPOLICY)
	@rm -rf $(GPLALLOW)
	@mkdir -p $(GPLALLOW)/include $(GPLALLOW)/local
	@awk '$$1 == "allow-header" {print $$2}' $(GPLPOLICY) | while read -r p; do \
		src=$(abspath $(SRCBASE))/gpl/$$p; \
		[ -f "$$src" ] || { echo "gplallow: $$src missing" >&2; continue; }; \
		case $$p in \
		include/*) mkdir -p "$(GPLALLOW)/$$(dirname $$p)"; ln -s "$$src" "$(GPLALLOW)/$$p" ;; \
		*) ln -s "$$src" "$(GPLALLOW)/local/$$(basename $$p)" ;; \
		esac; \
	done
	@touch $@

#
# Syntax-only dry run. One status file per translation unit, so it runs in
# parallel and is restartable; never fails. Columns of syntax-report.tsv:
# status (ok|fail), source, first error.
#
SYNTAX_DIR	= $(OBJS_DIR)/syntax
SYNTAX_FILES	= $(ALL_SRCS:%.c=$(SYNTAX_DIR)/%.syn)
SYNTAX_FLAGS	= -fsyntax-only -fmax-errors=5

syntax-check: $(SYNTAX_FILES)
	@cat $(SYNTAX_FILES) | sort -k2 > $(OBJS_DIR)/syntax-report.tsv
	@echo "== $(MODULE): translation units failing -fsyntax-only:"
	@awk -F'\t' '$$1 == "fail" {printf "  %s\n      %s\n", $$2, $$3}' $(OBJS_DIR)/syntax-report.tsv
	@awk -F'\t' '{n[$$1]++} END {printf "== $(MODULE): %d ok, %d fail of %d (report: %s)\n", n["ok"], n["fail"], NR, "$(OBJS_DIR)/syntax-report.tsv"}' $(OBJS_DIR)/syntax-report.tsv

$(SYNTAX_DIR)/%.syn: FORCE | gplallow
	@mkdir -p $(@D)
	@if $(CC) $(CFLAGS) $(CPPFLAGS) -DKBUILD_BASENAME='"$(*F)"' $(CFLAGS_$(*F)) \
	    $(SYNTAX_FLAGS) $(SRCBASE)/$*.c > $@.log 2>&1; then \
		printf 'ok\t%s\t\n' "$*.c" > $@; \
	else \
		e=$$(grep -m1 'error' $@.log | sed 's|^$(SRCBASE)/||; s/\t/ /g'); \
		printf 'fail\t%s\t%s\n' "$*.c" "$$e" > $@; \
	fi

FORCE:

objlist:
	@for s in $(ALL_SRCS); do echo "$$s"; done
	@echo "== $(MODULE): $(words $(LINUX_SRCS)) imported + $(words $(GLUE_SRCS)) glue sources"

sizecheck: $(BINARY)
	@$(SIZE) $(BINARY)
	@kb=$$(du -k $(BINARY) | awk '{print $$1}'); \
	echo "$(MODULE): file size $${kb} KiB (includes DWARF/CTF, not all loaded)"; \
	t=$$($(SIZE) $(BINARY) | awk 'NR == 1 && /=/ {print int($$NF / 1024); exit} \
	    NR == 2 {print int($$4 / 1024); exit}'); \
	if [ -n "$$t" ] && [ "$$t" -gt $(MODSIZE_WARN_KB) ]; then \
		echo "WARNING: $(MODULE) loaded size $${t} KiB > $(MODSIZE_WARN_KB) KiB (docs/11 section 3)"; fi

install: all
	$(SRCBASE)/scripts/install-all.sh -R "$(or $(DESTDIR),/)" -o $(OBJS_DIR) -m $(MODULE)

clean:
	rm -f $(OBJECTS)
	rm -rf $(SYNTAX_DIR) $(GPLALLOW)

clobber: clean
	rm -f $(BINARY) $(OBJS_DIR)/syntax-report.tsv
	-rm -rf $(OBJTREE)
	-rmdir $(OBJS_DIR) 2>/dev/null
# (build/i915/obj64/firmware, the firmware staging area, survives clobber.)
