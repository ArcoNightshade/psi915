# linuxkpi_drm misc module: Linux DRM core + KMS/display helpers + TTM +
# drm_buddy + video helpers (drm/), drm_bsd/ and (DRMGLUE_IN=drm only)
# drmglue/. Installed as /usr/kernel/misc/amd64/linuxkpi_drm.
#
#   gmake [DEBUG=1] [WITH_DRM_SCHED=1]   build
#   gmake syntax-check [HOST_STUBS=1]    per-file -fsyntax-only report
#   gmake -n                             show the commands
#
# Object lists: Objects.mk, generated by scripts/gen-module-objs.sh from
# third_party/IMPORT_FILES (sets core + link). UNTESTED ON ILLUMOS.
#

BUILDBASE	= ..

MODULE		= linuxkpi_drm
MODDEPS		= misc/linuxkpi misc/linuxkpi_gpl_g1
LINUX_MODNAME	= drm
LKPI_LICENCE	= mit

# The DRM GPU scheduler is imported (set "extra") but i915 does not use it.
WITH_DRM_SCHED	= 0

include Objects.mk

LINUX_SRCS	= $(DRM_SRCS) $(DRM_VIDEO_SRCS) $(DRM_BSD_SRCS) \
		  $(if $(filter 1,$(WITH_DRM_SCHED)),$(DRM_SCHED_SRCS))
GLUE_SRCS	= build/drm/linuxkpi_drm_mod.c \
		  $(if $(filter drm,$(DRMGLUE_IN)),$(DRMGLUE_SRCS))
MODULE_INC_LATE	= -I$(SRCBASE)/drm/drivers/gpu/drm
MODULE_DEFS	= $(if $(filter 1,$(WITH_DRM_SCHED)),-DPSI915_WITH_DRM_SCHED) \
		  $(if $(filter drm,$(DRMGLUE_IN)),-DPSI915_DRMGLUE_HERE)

include ../drm/Makefile.lkpi
