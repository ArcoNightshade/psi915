#
# Object lists per kernel module (cf. illumos uts/common/Makefile.files).
# Sources live in src/; objects are named after their source file.
#

#
#	linuxkpi: LinuxKPI core misc module
#
LINUXKPI_OBJS	+= linuxkpi_mod.o \
		   plat_illumos.o \
		   linux_printk.o \
		   linux_slab.o \
		   linux_lock.o \
		   linux_list_sort.o \
		   linux_rbtree.o \
		   linux_rcu.o \
		   linux_xarray.o \
		   linux_idr.o \
		   linux_sched.o \
		   linux_wait.o

#
#	lkpi_ktest: kernel test module (tests/kernel/ktest_main.c plus the
#	unit tests compiled with -DLKPI_KTEST); development only
#
LKPI_KTEST_OBJS	+= ktest_main.o \
		   test_kernel.o \
		   test_list.o \
		   test_kref.o \
		   test_atomic.o \
		   test_bitops.o \
		   test_printk.o \
		   test_slab.o \
		   test_locks.o \
		   test_list_sort.o \
		   test_rbtree.o \
		   test_rcu.o \
		   test_xarray.o \
		   test_sched.o
