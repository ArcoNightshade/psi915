#
# Object lists per kernel module (cf. illumos uts/common/Makefile.files).
# Sources live in src/; objects are named after their source file.
#

#
#	linuxkpi: LinuxKPI core misc module
#
LINUXKPI_OBJS	+= linuxkpi_mod.o \
		   plat_illumos.o \
		   plat_illumos_dev.o \
		   linux_acpi.o \
		   linux_cpu.o \
		   linux_device.o \
		   linux_devres.o \
		   linux_dma.o \
		   linux_dmapool.o \
		   linux_firmware.o \
		   linux_i2c.o \
		   linux_idr.o \
		   linux_io.o \
		   linux_irq.o \
		   linux_kstrtox.o \
		   linux_kthread.o \
		   linux_list_sort.o \
		   linux_lock.o \
		   linux_mempool.o \
		   linux_moduleparam.o \
		   linux_page.o \
		   linux_pci.o \
		   linux_pci_ddi.o \
		   linux_printk.o \
		   linux_rbtree.o \
		   linux_rcu.o \
		   linux_scatterlist.o \
		   linux_sched.o \
		   linux_slab.o \
		   linux_sort.o \
		   linux_srcu.o \
		   linux_timer.o \
		   linux_wait.o \
		   linux_workqueue.o \
		   linux_ww_mutex.o \
		   linux_xarray.o

#
#	lkpi_ktest: kernel test module (tests/kernel/ktest_main.c plus the
#	unit tests compiled with -DLKPI_KTEST); development only
#
LKPI_KTEST_OBJS	+= ktest_main.o \
		   test_kernel.o \
		   test_list.o \
		   test_kref.o \
		   test_atomic.o \
		   test_bitops.o \
		   test_printk.o \
		   test_slab.o \
		   test_locks.o \
		   test_list_sort.o \
		   test_rbtree.o \
		   test_rcu.o \
		   test_xarray.o \
		   test_sched.o \
		   test_workqueue.o \
		   test_misc.o

#
#	lkpi_toy: toy_edu PCI driver (drivers/toy), P2 exit artifact
#
LKPI_TOY_OBJS	+= toy_edu.o \
		   toy_ddi.o
