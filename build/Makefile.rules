#
# Pattern rules (cf. illumos uts/intel/Makefile.rules): map each source
# directory to objects in the per-module $(OBJS_DIR).
#

$(OBJS_DIR)/%.o: $(KSRCBASE)/%.c | $(OBJS_DIR)
	$(COMPILE.c) -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@)

# drmglue, linked into linuxkpi (Makefile.files DRMGLUE_OBJS).
$(OBJS_DIR)/drmglue_%.o: $(SRCBASE)/drmglue/src/%.c | $(OBJS_DIR)
	$(COMPILE.c) -I$(SRCBASE)/drmglue/include -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@)

# Kernel test module: the unit tests and their kernel entry point.
$(OBJS_DIR)/%.o: $(SRCBASE)/tests/%.c | $(OBJS_DIR)
	$(COMPILE.c) -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@)

$(OBJS_DIR)/%.o: $(SRCBASE)/tests/kernel/%.c | $(OBJS_DIR)
	$(COMPILE.c) -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@)

# Toy PCI driver.
$(OBJS_DIR)/%.o: $(SRCBASE)/drivers/toy/%.c | $(OBJS_DIR)
	$(COMPILE.c) -o $@ $<
	$(if $(CTFCONVERT),$(CTFCONVERT) $(CTFCVTFLAGS) $@)
