# i915 driver module: the Linux 6.14 i915 Gen9 build set (i915/, sets core
# and link), drm_bsd's i915 replacements and the illumos glue
# (drivers/i915_glue). Installed as /usr/kernel/drv/amd64/i915 with
# drivers/i915_glue/i915.conf; registered with add_drv (scripts/install-all.sh
# prints the command, docs/11 section 6).
#
#   gmake [DEBUG=1]                      build
#   gmake syntax-check [HOST_STUBS=1]    per-file -fsyntax-only report
#   gmake sizecheck                      section sizes of the linked module
#   gmake -n                             show the commands
#
# Object lists: Objects.mk, generated by scripts/gen-module-objs.sh.
# UNTESTED ON ILLUMOS.
#

BUILDBASE	= ..

MODULE		= i915
# Everything i915 calls directly. gfx_private and acpica are also needed by
# linuxkpi; listing them keeps the dependency explicit for the console code.
MODDEPS		= misc/linuxkpi misc/linuxkpi_gpl_g1 misc/linuxkpi_drm \
		  misc/linuxkpi_gpl_g2 misc/gfx_private misc/acpica
LINUX_MODNAME	= i915
LKPI_LICENCE	= mit

include Objects.mk

LINUX_SRCS	= $(I915_SRCS) $(I915_LINK_SRCS) $(I915_BSD_SRCS)
GLUE_SRCS	= drivers/i915_glue/i915_ddi.c drivers/i915_glue/i915_drm_glue.c

# drm_bsd replacements shadow i915 headers (MANIFEST: i915_trace.h, ...).
MODULE_INC	= -I$(SRCBASE)/drm_bsd/drivers/gpu/drm/i915 \
		  -I$(SRCBASE)/drm_bsd/drivers/gpu/drm/i915/display \
		  -I$(SRCBASE)/drivers/i915_glue
# kbuild: subdir-ccflags-y += -I$(src); display/ for drm_bsd's intel_acpi.c.
MODULE_INC_LATE	= -I$(SRCBASE)/i915/drivers/gpu/drm/i915 \
		  -I$(SRCBASE)/i915/drivers/gpu/drm/i915/display
# kbuild: subdir-ccflags-y += -DI915 (i915 vs xe display build, e.g.
# i9xx_wm.h only declares its functions for I915).
MODULE_DEFS	= -DI915

include ../drm/Makefile.lkpi
