#
# Neutral install layout, consumed by scripts/install.sh and by the IPS and
# SVR4 package wrappers (scripts/install.sh -f ips|svr4).
#
# type	mode	owner	group	path (relative to /)	source (relative to repo; @OBJDIR@ = obj64|debug64)
dir	0755	root	sys	usr/kernel
dir	0755	root	sys	usr/kernel/misc
dir	0755	root	sys	usr/kernel/misc/amd64
file	0755	root	sys	usr/kernel/misc/amd64/linuxkpi	build/linuxkpi/@OBJDIR@/linuxkpi
