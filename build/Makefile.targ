#
# Common targets for one kernel module (cf. illumos uts/Makefile.targ).
# The including Makefile defines MODULE, OBJECTS and optionally MODDEPS.
#

BINARY		= $(OBJS_DIR)/$(MODULE)

.PHONY: all install clean clobber objects

all: $(BINARY)

# Objects only (scripts/illumos-hdr-check.sh: real illumos headers on a
# Linux host, no kmod link).
objects: $(OBJECTS)

$(OBJS_DIR):
	mkdir -p $@

$(BINARY): $(OBJECTS)
	$(LD) $(LD_KMOD_TYPE) $(LDFLAGS) -o $@ $(OBJECTS)
	$(if $(CTFMERGE),$(CTFMERGE) $(CTFMRGFLAGS) -o $@ $(OBJECTS))

# Installs every artefact in build/install.manifest, not just this module.
# Modules outside the installed layout set NO_INSTALL = 1.
ifeq ($(NO_INSTALL),1)
install: all
	@echo "$(MODULE) is not installed; modload $(CURDIR)/$(BINARY)"
else
install: all
	$(INSTALL_SH) -R "$(DESTDIR)" -o $(OBJS_DIR)
endif

clean:
	rm -f $(OBJECTS)

clobber: clean
	rm -f $(BINARY)
	-rmdir $(OBJS_DIR) 2>/dev/null
