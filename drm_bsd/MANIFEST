# drm_bsd manifest: psi915's BSD-2-Clause clean-room replacements for GPL-only upstream files.
# These were written from documented API behaviour, the MIT/BSD-licensed callers and headers in drm/
# and i915/, and the MIT uAPI.  They were not written from the GPL sources, which stay in gpl/
# (set "replaced", not imported by default) only so that the import remains reproducible.
#
# Format: <set><TAB><path below drm_bsd/><TAB><replaces (upstream path)><TAB><notes>
# Sets as in third_party/manifest: core = compiled for Gen9, hdr = header.
# Build: drm_bsd/ is compiled into the same modules as drm/ and i915/: the DRM core files go into
# drm, intel_acpi.c into i915, and video/ into drm.  Put these directories on the include path
# ahead of drm/include:
#   drm_bsd/include, drm_bsd/drivers/gpu/drm, drm_bsd/drivers/gpu/drm/i915,
#   drm_bsd/drivers/gpu/drm/i915/display.
# gpl/ must never be on the include path of an MIT/BSD compile (import-linux.sh -c checks this).
core	drivers/gpu/drm/drm_managed.c	drivers/gpu/drm/drm_managed.c	full implementation of the drmm_* interface
core	drivers/gpu/drm/drm_sysfs.c	drivers/gpu/drm/drm_sysfs.c	struct device per minor and per connector; uevents go to an optional illumos hook; no sysfs attributes
core	drivers/gpu/drm/drm_lease.c	drivers/gpu/drm/drm_lease.c	leases not granted (CREATE_LEASE -> EOPNOTSUPP); query ioctls answer for owner masters
core	drivers/gpu/drm/drm_writeback.c	drivers/gpu/drm/drm_writeback.c	stub: i915 has no writeback connectors; job lifetime functions only
core	drivers/gpu/drm/i915/display/intel_acpi.c	drivers/gpu/drm/i915/display/intel_acpi.c	no-ops (vga_switcheroo DSM, ACPI video, DIDL, fwnodes); reductions listed in the file
core	drivers/video/cmdline.c	drivers/video/cmdline.c	options set by the illumos glue (video_bsd_set_option) instead of video= on the command line
core	drivers/video/nomodeset.c	drivers/video/nomodeset.c	policy set by the illumos glue (video_bsd_set_firmware_drivers_only); default off
hdr	include/drm/drm_managed.h	include/drm/drm_managed.h	interface used by the MIT callers
hdr	include/drm/drm_sysfs.h	include/drm/drm_sysfs.h	plus the psi915 uevent hook
hdr	include/drm/drm_lease.h	include/drm/drm_lease.h	interface used by the MIT callers
hdr	include/drm/drm_writeback.h	include/drm/drm_writeback.h	job/connector structures with the members the atomic core uses
hdr	drivers/gpu/drm/drm_trace.h	drivers/gpu/drm/drm_trace.h	no-op trace points (generated by tools/gen-drm-bsd-trace.py)
hdr	drivers/gpu/drm/i915/i915_trace.h	drivers/gpu/drm/i915/i915_trace.h	no-op trace points (generated)
hdr	drivers/gpu/drm/i915/display/intel_display_trace.h	drivers/gpu/drm/i915/display/intel_display_trace.h	no-op trace points (generated)
hdr	drivers/gpu/drm/i915/intel_uncore_trace.h	drivers/gpu/drm/i915/intel_uncore_trace.h	no-op trace point (generated)
# Replaced without a file: the trace-point definition units drivers/gpu/drm/drm_trace_points.c,
# i915/i915_trace_points.c, i915/display/intel_display_trace.c and i915/intel_uncore_trace.c
# define nothing when CONFIG_TRACEPOINTS is off, so nothing replaces them.
