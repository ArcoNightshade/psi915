# Regenerate driver_aliases.gen9 from a Linux pciids.h (GNU make).
#   make PCIIDS=/path/to/include/drm/intel/pciids.h
REF	?= $(HOME)/ref
PCIIDS	?= $(REF)/drm-kmod/include/drm/intel/pciids.h

driver_aliases.gen9: gen-driver-aliases.sh $(PCIIDS)
	{ echo "# driver_aliases(5) fragment: Gen9 Intel GPUs -> i915 (psi915)."; \
	  echo "# Generated by gen-driver-aliases.sh from $(notdir $(PCIIDS))"; \
	  echo "# (families SKL BXT GLK KBL AML CFL WHL CML). Target device:"; \
	  echo "# pci8086,5917 (Kaby Lake-R UHD 620). Installed by add_drv or the IPS"; \
	  echo "# driver action, never by editing /etc/driver_aliases by hand."; \
	  sh gen-driver-aliases.sh $(PCIIDS); } > $@.new
	mv $@.new $@
